{% extends 'base.html.twig' %}

{% block title %}Stats{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h2 class="mb-4">Estadísticas por categoría</h2>

        <div class="row g-4">
            {% for category in categories %}
                <div class="col-md-3">
                    <a href="{{ path('stats_category', {id: category.id}) }}"
                       class="card text-center shadow-sm border-0 card-hover text-decoration-none">
                        <div class="card-body py-4">
                            <h5 class="fw-semibold text-dark">{{ category.name }}</h5>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
