{% extends 'base.html.twig' %}

{% block title %}Rankings{% endblock %}

{% block body %}
<div class="container mt-5">
    <h2 class="mb-4 text-center">Elige una categoría para hacer un ranking de sus productos</h2>

    <div class="row g-4 justify-content-center">
       {% for category in categories %}
           <div class="col-6 col-md-3 col-lg-2">
                <a href="{{ path('rankings_category', {id: category.id}) }}" class="text-decoration-none">
                    <div class="card h-100 shadow-sm card-hover text-center">
                        {% if category.image %}
                            <img src="{{ category.image }}" class="card-img-top" alt="{{ category.name }}">
                        {% else %}
                            <img src="{{ asset('img/category-placeholder.png') }}" class="card-img-top" alt="{{ category.name }}">
                        {% endif %}
                        <div class="card-body">
                            <h6 class="card-title">{{ category.name }}</h6>
                        </div>
                    </div>
                </a>
           </div>
       {% else %}
           <p class="text-center text-muted">No hay categorías disponibles</p>
       {% endfor %}
    </div>
</div>
{% endblock %}
